<header class="brand-header">
    <a href="#main-content" class="brand-skip">Skip to content</a>
    <div class="brand-container">
        <div class="brand-header-row">
            <BrandLogo />
            <nav class="brand-nav" aria-label="Primary">
                <NavLink href="." Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="services">Services</NavLink>
                <NavLink href="blog">Blog</NavLink>
                <NavLink href="about">About</NavLink>
            </nav>
            <div class="brand-tools">
                <ThemeSelector />
                <NavLink href="contact" class="brand-button brand-desktop-contact">Contact Us</NavLink>
                <button type="button" data-testid="mobile-menu-button" class="brand-menu-toggle"
                        aria-label="Main menu" aria-controls="mobile-navigation" aria-expanded="@(mobileMenuOpen ? "true" : "false")"
                        @onclick="ToggleMobileMenu">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        @if (mobileMenuOpen)
                        { <path d="M6 6l12 12M18 6L6 18" /> }
                        else
                        { <path d="M4 6h16M4 12h16M4 18h16" /> }
                    </svg>
                </button>
            </div>
        </div>
        <nav id="mobile-navigation" data-testid="mobile-menu" class="brand-mobile-nav" aria-label="Mobile primary" hidden="@(!mobileMenuOpen)">
            <NavLink href="." Match="NavLinkMatch.All" @onclick="CloseMobileMenu">Home</NavLink>
            <NavLink href="services" @onclick="CloseMobileMenu">Services</NavLink>
            <NavLink href="blog" @onclick="CloseMobileMenu">Blog</NavLink>
            <NavLink href="about" @onclick="CloseMobileMenu">About</NavLink>
            <NavLink href="contact" @onclick="CloseMobileMenu">Contact Us</NavLink>
        </nav>
    </div>
</header>

@code {
    private bool mobileMenuOpen;
    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() => mobileMenuOpen = false;
}
