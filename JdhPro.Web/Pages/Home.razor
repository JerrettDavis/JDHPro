@page "/"

<PageTitle>JDH Productions | Engineering, Design &amp; Production</PageTitle>

<section class="home-hero brand-section" aria-labelledby="home-heading">
    <div class="brand-container home-hero-grid">
        <div>
            <p class="brand-eyebrow">Engineering · Design · Production</p>
            <h1 id="home-heading" class="home-heading">Ideas engineered.<br /><span class="brand-mark">Solutions built.</span></h1>
            <p class="home-lead">We bring ideas into existence through software engineering, technical consulting, intelligent automation, and digital manufacturing.</p>
            <div class="home-actions">
                <a class="brand-button" href="#services">Explore our capabilities</a>
                <a data-testid="start-project-cta" class="brand-button secondary" href="#contact">Start a project</a>
            </div>
        </div>
        <div class="home-illustration" aria-hidden="true">
            <svg viewBox="0 0 500 420" fill="none" focusable="false">
                <g class="home-diagram-grid">
                    @for (var i = 0; i <= 20; i++)
                    {
                        <path d="@($"M{i * 25} 0 V420")" />
                    }
                    @for (var i = 0; i <= 16; i++)
                    {
                        <path d="@($"M0 {i * 26} H500")" />
                    }
                </g>
                <g stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                    <path d="M100 145 248 65 400 145 252 225Z M100 145V267L252 350 400 267V145 M252 225V350" />
                    <path opacity=".55" d="M174 105 326 185V307 M176 185 324 105 M100 206 252 289 400 206" />
                    <path opacity=".7" stroke-dasharray="5 6" d="M100 145 47 175V287L252 397 451 287V175L400 145 M248 65V27" />
                    <path d="M35 65V30H75 M465 350V390H425" />
                    <circle cx="248" cy="65" r="6" class="home-node" />
                    <circle cx="252" cy="225" r="6" class="home-node" />
                    <circle cx="400" cy="267" r="6" class="home-node" />
                    <circle cx="100" cy="267" r="6" class="home-node" />
                </g>
                <g class="home-diagram-label">
                    <text x="24" y="412">DESIGN / ENGINEER / PRODUCE</text>
                    <text x="474" y="24" text-anchor="end">JDH / 01</text>
                </g>
            </svg>
        </div>
    </div>
</section>

<div class="home-discipline-strip" aria-label="Core disciplines">
    <div class="brand-container home-disciplines">
        <span>Software</span><span>Automation</span><span>Architecture</span><span>Fabrication</span>
    </div>
</div>

<section id="services" class="brand-section" aria-labelledby="capabilities-heading">
    <div class="brand-container">
        <p class="brand-eyebrow">What we do</p>
        <h2 id="capabilities-heading" class="mt-3">Capabilities, not just services.</h2>
        <p class="brand-muted mt-3 max-w-2xl">From the systems that power businesses to the products people interact with, we design and build practical solutions.</p>
        <div class="home-capabilities mt-8">
            @foreach (var capability in Capabilities)
            {
                <article data-testid="service-card" class="brand-card home-capability">
                    <div class="home-capability-icon" aria-hidden="true">
                        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="@capability.IconPath" />
                        </svg>
                    </div>
                    <h3 class="home-card-title">@capability.Title</h3>
                    <p class="brand-muted">@capability.Description</p>
                    <a href="@capability.Href" class="home-card-link">Learn more <span aria-hidden="true">→</span><span class="sr-only"> about @capability.Title</span></a>
                </article>
            }
        </div>
    </div>
</section>

<section class="brand-section brand-surface" aria-labelledby="approach-heading">
    <div class="brand-container home-approach">
        <div>
            <p class="brand-eyebrow">How we work</p>
            <h2 id="approach-heading" class="mt-3">Engineering with purpose.</h2>
            <p class="brand-muted mt-4">Start with the problem. Design for the people who use the solution. Build with maintainability, adaptability, and real-world constraints in mind.</p>
        </div>
        <div class="home-approach-steps">
            @foreach (var phase in Phases)
            {
                <div class="home-approach-step">
                    <span class="brand-eyebrow">@phase.Number</span>
                    <div><h3 class="home-card-title">@phase.Title</h3><p class="brand-muted">@phase.Description</p></div>
                </div>
            }
        </div>
    </div>
</section>

<section class="brand-section" aria-labelledby="ecosystem-heading">
    <div class="brand-container">
        <p class="brand-eyebrow">Our ecosystem</p>
        <h2 id="ecosystem-heading" class="mt-3">Products &amp; ventures</h2>
        <div class="brand-content-grid mt-8">
            <article class="brand-card brand-venture"><p class="brand-eyebrow">Fabrication</p><h3>3dprint4.me</h3><p class="brand-muted">Custom 3D printing and digital manufacturing.</p><a href="https://3dprint4.me/">Visit 3dprint4.me <span aria-hidden="true">↗</span></a></article>
            <article class="brand-card brand-venture"><p class="brand-eyebrow">Software · In development</p><h3>FlowLedger</h3><p class="brand-muted">Personal finance software designed around clarity and organization.</p><NavLink href="products">Explore our ventures</NavLink></article>
        </div>
    </div>
</section>
<section class="brand-section brand-surface" aria-labelledby="work-heading">
    <div class="brand-container">
        <p class="brand-eyebrow">Selected work</p>
        <h2 id="work-heading" class="mt-3">Engineering in practice.</h2>
        <div class="brand-content-grid mt-8">
            <article class="brand-card brand-venture"><p class="brand-eyebrow">Open source</p><h3>TinyBDD</h3><p class="brand-muted">Fluent behavior-driven development for .NET.</p><a href="https://github.com/JerrettDavis/TinyBDD">Explore the source <span aria-hidden="true">↗</span></a></article>
            <article class="brand-card brand-venture"><p class="brand-eyebrow">Web engineering</p><h3>JDH Productions website</h3><p class="brand-muted">A themeable Blazor WebAssembly website with automated browser tests.</p><a href="https://github.com/JerrettDavis/JDHPro">Explore the source <span aria-hidden="true">↗</span></a></article>
        </div>
        <NavLink href="projects" class="brand-button secondary mt-6">View our work</NavLink>
    </div>
</section>
<section class="brand-section" aria-labelledby="labs-heading">
    <div class="brand-container home-contact-inner">
        <div><p class="brand-eyebrow">Research &amp; development</p><h2 id="labs-heading" class="mt-3">JDH Labs</h2><p class="brand-muted mt-3">Explore our technical writing, open-source projects, and areas of experimentation.</p></div>
        <div class="home-actions"><NavLink href="labs" class="brand-button">Explore Labs</NavLink><NavLink href="blog" class="brand-button secondary">Read insights</NavLink></div>
    </div>
</section>

<section id="contact" class="brand-section home-contact" aria-labelledby="contact-heading">
    <div class="brand-container home-contact-inner">
        <div>
            <p class="brand-eyebrow">Have something in mind?</p>
            <h2 id="contact-heading" class="mt-3">Let's build something useful.</h2>
            <p class="brand-muted mt-3">Tell us about your project, the problem you're solving, and what a successful outcome looks like.</p>
        </div>
        <NavLink href="contact" class="brand-button">Start a conversation</NavLink>
    </div>
</section>

@code {
    private record Capability(string Title, string Description, string IconPath, string Href);

    private static readonly Capability[] Capabilities =
    [
        new("Software engineering", "Custom application development, platforms, and system integration.", "M10 7 2 16 10 25 M22 7 30 16 22 25 M19 5 13 27", "services"),
        new("AI & automation", "AI-assisted workflows, intelligent systems, and practical process automation.", "M5 5h4v4H5z M23 5h4v4h-4z M14 23h4v4h-4z M9 7h14 M7 9l9 14 M25 9l-9 14", "services"),
        new("Design & fabrication", "Digital manufacturing, custom 3D printing, and physical prototyping.", "M3 9 16 2 29 9 16 16Z M3 9v14l13 7 13-7V9 M16 16v14", "https://3dprint4.me/"),
        new("Technical consulting", "Technical architecture, strategy, process engineering, and implementation guidance.", "M3 7 16 2 29 7 16 12Z M3 15l13 5 13-5 M3 23l13 5 13-5", "services")
    ];

    private static readonly (string Number, string Title, string Description)[] Phases =
    [
        ("01", "Understand", "Identify the actual problem, constraints, and intended outcomes."),
        ("02", "Design", "Evaluate approaches and define a solution appropriate to the problem."),
        ("03", "Build", "Implement, test, iterate, and deliver something maintainable.")
    ];
}
