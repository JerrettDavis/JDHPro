@inject IJSRuntime JS

<div class="brand-appearance">
    <button id="brand-theme-trigger" data-testid="theme-select" data-theme-choice="@selection"
            type="button" class="brand-theme-trigger" popovertarget="brand-theme-panel"
            aria-haspopup="dialog" aria-controls="brand-theme-panel" aria-expanded="false"
            aria-label="@($"Appearance: {CurrentLabel}")" title="Change appearance" disabled="@(!ready)">
        <span class="brand-theme-indicator" aria-hidden="true">
            <span></span><span></span><span></span>
        </span>
        <span class="brand-theme-trigger-label">@CurrentLabel</span>
        <svg class="brand-theme-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m4 6 4 4 4-4" />
        </svg>
    </button>

    <section id="brand-theme-panel" data-testid="theme-panel" popover="auto"
             class="brand-theme-panel" role="dialog" aria-labelledby="brand-theme-heading">
        <div class="brand-theme-panel-heading">
            <div>
                <h2 id="brand-theme-heading">Appearance</h2>
                <p>Choose your JDH identity.</p>
            </div>
            <button type="button" class="brand-theme-close" popovertarget="brand-theme-panel"
                    popovertargetaction="hide" aria-label="Close appearance picker">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
            </button>
        </div>

        @foreach (var family in Families)
        {
            <div class="brand-theme-family" role="group" aria-label="@family.Label">
                <h3>@family.Label</h3>
                <div class="@(family.Options.Length == 3 ? "brand-theme-options brand-theme-options-three" : "brand-theme-options")">
                    @foreach (var option in family.Options)
                    {
                        <button @key="option.Id" type="button" class="brand-theme-option"
                                data-testid="@($"theme-option-{option.Id}")" aria-label="@option.Label"
                                aria-pressed="@(selection == option.Id ? "true" : "false")"
                                @onclick="() => ApplyAsync(option.Id)">
                            <span class="brand-theme-preview" data-preview-theme="@option.Id" aria-hidden="true">
                                <span class="brand-theme-preview-header">
                                    <span class="brand-theme-preview-logo"></span>
                                    <span class="brand-theme-preview-nav"></span>
                                </span>
                                <span class="brand-theme-preview-body">
                                    <span class="brand-theme-preview-copy">
                                        <span class="brand-theme-preview-title"></span>
                                        <span class="brand-theme-preview-line"></span>
                                        <span class="brand-theme-preview-button"></span>
                                    </span>
                                    <span class="brand-theme-preview-art"></span>
                                </span>
                            </span>
                            <span class="brand-theme-option-label">
                                <span>@option.ShortLabel</span>
                                <span class="brand-theme-check" aria-hidden="true">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8 3 3 6-6" /></svg>
                                </span>
                            </span>
                        </button>
                    }
                </div>
            </div>
        }

        <div class="brand-theme-system-wrap">
            <button type="button" class="brand-theme-system" data-testid="theme-option-system"
                    aria-label="System appearance" aria-pressed="@(selection == "system" ? "true" : "false")"
                    @onclick='() => ApplyAsync("system")'>
                <span class="brand-theme-system-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="13" rx="2" />
                        <path d="M12 17v4M8 21h8M12 5v11" />
                        <path d="M12 5h7a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-7z" fill="currentColor" stroke="none" opacity=".28" />
                    </svg>
                </span>
                <span class="brand-theme-system-copy"><strong>System appearance</strong><span>Follow your device's light or dark mode.</span></span>
                <span class="brand-theme-check" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8 3 3 6-6" /></svg>
                </span>
            </button>
        </div>
    </section>
</div>

@code {
    private sealed record ThemeOption(string Id, string Label, string ShortLabel);
    private sealed record ThemeFamily(string Label, ThemeOption[] Options);

    private static readonly ThemeFamily[] Families =
    [
        new("Professional", [
            new("professional", "Professional", "Light"),
            new("professional-dark", "Professional dark", "Dark")
        ]),
        new("Vaporwave", [
            new("vaporwave-light", "Vaporwave light", "Light"),
            new("vaporwave", "Vaporwave", "Dark")
        ]),
        new("Neutral", [
            new("grayscale", "Grayscale", "Grayscale"),
            new("monochrome-light", "Black on white", "Black on white"),
            new("monochrome-dark", "White on black", "White on black")
        ])
    ];

    private string selection = "professional";
    private bool ready;

    private string CurrentLabel => selection == "system"
        ? "System"
        : Families.SelectMany(f => f.Options).FirstOrDefault(o => o.Id == selection)?.Label ?? "Professional";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selection = await JS.InvokeAsync<string>("jdhTheme.get");
        ready = true;
        StateHasChanged();
    }

    private async Task ApplyAsync(string value)
    {
        await JS.InvokeVoidAsync("jdhTheme.set", value);
        selection = value;
        await JS.InvokeVoidAsync("jdhTheme.closePicker");
    }
}
