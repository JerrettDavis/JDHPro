@page "/projects"
<PageTitle>Our work | JDH Productions</PageTitle>

<section class="brand-section brand-page-intro">
    <div class="brand-container">
        <p class="brand-eyebrow">Selected work</p>
        <h1 class="brand-page-title">Projects</h1>
        <p class="brand-page-lead">Explore publicly available examples of our engineering and production work. More detailed case studies can be published as they are approved for sharing.</p>
    </div>
</section>
<section class="brand-section" aria-label="Public projects">
    <div class="brand-container brand-content-grid">
        <article data-testid="project-card" class="brand-card brand-venture">
            <p class="brand-eyebrow">Developer tooling</p>
            <h2>TinyBDD</h2>
            <p class="brand-muted">A fluent behavior-driven development library for .NET, with an emphasis on readable specifications and automated tests.</p>
            <a href="https://github.com/JerrettDavis/TinyBDD">Explore the source <span aria-hidden="true">↗</span></a>
        </article>
        <article data-testid="project-card" class="brand-card brand-venture">
            <p class="brand-eyebrow">Web engineering</p>
            <h2>JDH Productions website</h2>
            <p class="brand-muted">A Blazor WebAssembly website with a shared visual system, content syndication, and automated browser tests.</p>
            <a href="https://github.com/JerrettDavis/JDHPro">Explore the source <span aria-hidden="true">↗</span></a>
        </article>
        <article data-testid="project-card" class="brand-card brand-venture">
            <p class="brand-eyebrow">Digital manufacturing</p>
            <h2>3dprint4.me</h2>
            <p class="brand-muted">A venture focused on custom fabrication and digital manufacturing.</p>
            <a href="https://3dprint4.me/">Explore the venture <span aria-hidden="true">↗</span></a>
        </article>
    </div>
</section>
<section class="brand-section home-contact">
    <div class="brand-container home-contact-inner">
        <div><h2>Have a project in mind?</h2><p class="brand-muted mt-3">Tell us what you're trying to build.</p></div>
        <NavLink href="contact" class="brand-button">Start a conversation</NavLink>
    </div>
</section>
